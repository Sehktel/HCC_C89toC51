<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_HccV3" targetNamespace="http://hcc.c89toc51.local/bpmn" exporter="Camunda Modeler" exporterVersion="5.46.1">
  <bpmn:error id="Error_Compilation" name="CompilationError" errorCode="COMPILATION_ERROR" />
  <bpmn:process id="hcc-compilation-v3" name="HCC: компиляция v3 (subprocess)" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:documentation>
      Этап анализа — embedded subprocess. Ошибка компиляции: BpmnError(COMPILATION_ERROR)
      → boundary (молния) → Записать сбой → FAILED.
      Успех → parallel fork: subprocess «Генерация» + контур Zig → parallel join «Слияние» (2 входа) → Артефакты OK.
      Group «Контур Zig» — только визуал (не влияет на токены). «Нет» и Zig test → только в «Слияние», не в «Артефакты OK».
    </bpmn:documentation>
    <bpmn:startEvent id="Start" name="Старт">
      <bpmn:outgoing>Flow_To_Analysis</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="Sub_Analysis" name="1. ЭТАП АНАЛИЗА">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_To_Analysis</bpmn:incoming>
      <bpmn:outgoing>Flow_0ekpotp</bpmn:outgoing>
      <bpmn:startEvent id="Start_Analysis" name="">
        <bpmn:outgoing>Flow_A_Init</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Task_Init" name="Init" camunda:type="external" camunda:topic="hcc-init">
        <bpmn:incoming>Flow_A_Init</bpmn:incoming>
        <bpmn:outgoing>Flow_A_PP</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_Preprocess" name="Preprocessor" camunda:type="external" camunda:topic="hcc-stage-preprocess">
        <bpmn:incoming>Flow_A_PP</bpmn:incoming>
        <bpmn:outgoing>Flow_A_LEX</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_Lexer" name="Lexer" camunda:type="external" camunda:topic="hcc-stage-lexer">
        <bpmn:incoming>Flow_A_LEX</bpmn:incoming>
        <bpmn:outgoing>Flow_A_PAR</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_Parse" name="Parser" camunda:type="external" camunda:topic="hcc-stage-parse">
        <bpmn:incoming>Flow_A_PAR</bpmn:incoming>
        <bpmn:outgoing>Flow_A_AST</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_AST" name="AST / семантика" camunda:type="external" camunda:topic="hcc-stage-semantic">
        <bpmn:incoming>Flow_A_AST</bpmn:incoming>
        <bpmn:outgoing>Flow_A_End</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_Analysis" name="">
        <bpmn:incoming>Flow_A_End</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_A_Init" sourceRef="Start_Analysis" targetRef="Task_Init" />
      <bpmn:sequenceFlow id="Flow_A_PP" sourceRef="Task_Init" targetRef="Task_Preprocess" />
      <bpmn:sequenceFlow id="Flow_A_LEX" sourceRef="Task_Preprocess" targetRef="Task_Lexer" />
      <bpmn:sequenceFlow id="Flow_A_PAR" sourceRef="Task_Lexer" targetRef="Task_Parse" />
      <bpmn:sequenceFlow id="Flow_A_AST" sourceRef="Task_Parse" targetRef="Task_AST" />
      <bpmn:sequenceFlow id="Flow_A_End" sourceRef="Task_AST" targetRef="End_Analysis" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Boundary_CompileError" name="Ошибка компиляции" attachedToRef="Sub_Analysis">
      <bpmn:outgoing>Flow_To_Failure</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_Compilation" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_Publish_Failure" name="Записать сбой" camunda:type="external" camunda:topic="hcc-publish-failure">
      <bpmn:incoming>Flow_To_Failure</bpmn:incoming>
      <bpmn:incoming>Flow_1mgteb7</bpmn:incoming>
      <bpmn:outgoing>Flow_Failed_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_FAILED" name="FAILED">
      <bpmn:incoming>Flow_Failed_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="Sub_Codegen" name="2. ГЕНЕРАЦИЯ КОДА">
      <bpmn:incoming>Flow_0ekpotp</bpmn:incoming>
      <bpmn:outgoing>Flow_0wosy7n</bpmn:outgoing>
      <bpmn:startEvent id="Start_Codegen" name="">
        <bpmn:outgoing>Flow_C_HIR</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Task_HighIR" name="HighIR" camunda:type="external" camunda:topic="hcc-stage-highir">
        <bpmn:incoming>Flow_C_HIR</bpmn:incoming>
        <bpmn:outgoing>Flow_C_MIR</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_MediumIR" name="MedIR" camunda:type="external" camunda:topic="hcc-stage-mediumir">
        <bpmn:incoming>Flow_C_MIR</bpmn:incoming>
        <bpmn:outgoing>Flow_C_LIR</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_LowIR" name="LowIR" camunda:type="external" camunda:topic="hcc-stage-lowir">
        <bpmn:incoming>Flow_C_LIR</bpmn:incoming>
        <bpmn:outgoing>Flow_C_CG</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_Codegen" name="Codegen C51" camunda:type="external" camunda:topic="hcc-stage-codegen">
        <bpmn:incoming>Flow_C_CG</bpmn:incoming>
        <bpmn:outgoing>Flow_C_End</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_Codegen" name="">
        <bpmn:incoming>Flow_C_End</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_C_HIR" sourceRef="Start_Codegen" targetRef="Task_HighIR" />
      <bpmn:sequenceFlow id="Flow_C_MIR" sourceRef="Task_HighIR" targetRef="Task_MediumIR" />
      <bpmn:sequenceFlow id="Flow_C_LIR" sourceRef="Task_MediumIR" targetRef="Task_LowIR" />
      <bpmn:sequenceFlow id="Flow_C_CG" sourceRef="Task_LowIR" targetRef="Task_Codegen" />
      <bpmn:sequenceFlow id="Flow_C_End" sourceRef="Task_Codegen" targetRef="End_Codegen" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="Gw_Zig" name="Нужен Zig?" default="Flow_0dk5mny">
      <bpmn:incoming>Flow_0wosy7n</bpmn:incoming>
      <bpmn:outgoing>Flow_0dk5mny</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Zig_Test" name="Zig test (parallel MI)" camunda:type="external" camunda:topic="hcc-zig-test">
      <bpmn:incoming>Flow_Run_Zig</bpmn:incoming>
      <bpmn:outgoing>Flow_163s3tv</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics camunda:asyncBefore="true" camunda:exclusive="false" camunda:collection="${zigTestsList}" camunda:elementVariable="zigTests" />
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Publish_Success" name="Артефакты OK" camunda:type="external" camunda:topic="hcc-publish-success">
      <bpmn:incoming>Flow_0dk5mny</bpmn:incoming>
      <bpmn:incoming>Flow_163s3tv</bpmn:incoming>
      <bpmn:outgoing>Flow_OK_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_OK" name="OK">
      <bpmn:incoming>Flow_OK_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_To_Analysis" sourceRef="Start" targetRef="Sub_Analysis" />
    <bpmn:sequenceFlow id="Flow_To_Failure" sourceRef="Boundary_CompileError" targetRef="Task_Publish_Failure" />
    <bpmn:sequenceFlow id="Flow_Failed_End" sourceRef="Task_Publish_Failure" targetRef="End_FAILED" />
    <bpmn:sequenceFlow id="Flow_Run_Zig" name="Да" sourceRef="Gw_Zig" targetRef="Task_Zig_Test">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${enableZigMatrixTest == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_OK_End" sourceRef="Task_Publish_Success" targetRef="End_OK" />
    <bpmn:sequenceFlow id="Flow_0ekpotp" sourceRef="Sub_Analysis" targetRef="Sub_Codegen" />
    <bpmn:sequenceFlow id="Flow_0wosy7n" sourceRef="Sub_Codegen" targetRef="Gw_Zig" />
    <bpmn:sequenceFlow id="Flow_0dk5mny" sourceRef="Gw_Zig" targetRef="Task_Publish_Success" />
    <bpmn:sequenceFlow id="Flow_163s3tv" sourceRef="Task_Zig_Test" targetRef="Task_Publish_Success" />
    <bpmn:boundaryEvent id="Event_0kov8im" name="Ошибка компиляции" attachedToRef="Sub_Codegen">
      <bpmn:outgoing>Flow_1mgteb7</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_0gqsllr" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_1mgteb7" sourceRef="Event_0kov8im" targetRef="Task_Publish_Failure" />
    <bpmn:group id="Group_Zig" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_V3">
    <bpmndi:BPMNPlane id="BPMNPlane_V3" bpmnElement="hcc-compilation-v3">
      <bpmndi:BPMNShape id="Di_Fail" bpmnElement="Task_Publish_Failure">
        <dc:Bounds x="996" y="255" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Di_EndFail" bpmnElement="End_FAILED">
        <dc:Bounds x="1153" y="263" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1152" y="243" width="38" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Di_GwZig" bpmnElement="Gw_Zig" isMarkerVisible="true">
