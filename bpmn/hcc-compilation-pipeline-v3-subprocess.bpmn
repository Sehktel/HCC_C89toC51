      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Di_Success" bpmnElement="Task_Publish_Success">
        <dc:Bounds x="1236" y="415" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Di_EndOK" bpmnElement="End_OK">
        <dc:Bounds x="1393" y="432" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1402" y="413" width="17" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
