      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Di_SubCodegen" bpmnElement="Sub_Codegen" isExpanded="true">
        <dc:Bounds x="160" y="330" width="680" height="140" />
      </bpmndi:BPMNShape>
