          <dc:Bounds x="502" y="38" width="31" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Di_SubAnalysis" bpmnElement="Sub_Analysis" isExpanded="true">
        <dc:Bounds x="160" y="140" width="790" height="135" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Di_A_Init" bpmnElement="Task_Init">
        <dc:Bounds x="250" y="180" width="90" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Di_A_PP" bpmnElement="Task_Preprocess">
        <dc:Bounds x="370" y="180" width="90" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Di_A_LEX" bpmnElement="Task_Lexer">
        <dc:Bounds x="490" y="180" width="90" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Di_A_PAR" bpmnElement="Task_Parse">
        <dc:Bounds x="610" y="180" width="90" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Di_A_AST" bpmnElement="Task_AST">
        <dc:Bounds x="730" y="180" width="100" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Di_A_End" bpmnElement="End_Analysis">
        <dc:Bounds x="870" y="197" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Di_A_Start" bpmnElement="Start_Analysis">
        <dc:Bounds x="190" y="198" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_A_Init" bpmnElement="Flow_A_Init">
        <di:waypoint x="226" y="215" />
        <di:waypoint x="250" y="215" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_A_PP" bpmnElement="Flow_A_PP">
