NAME    BLINK_PROG

ORG     0000H           ; ????? ?????? ????????? (Reset Vector)
        JMP START

ORG     0030H           ; ????????, ????? ?? ???????????? ? ???????? ??????????
START:
    ; --- ????????? (P3.7 = 1) ---
    MOV P3, #080H       ; 0x75, 0xB0, 0x80: ?????? 1000 0000b ? ???? P3

DELAY_ON:
    MOV R0, #0FFH       ; 0x78, 0xFF
    MOV R1, #0FFH       ; 0x79, 0xFF
LOOP1:
    DJNZ R1, LOOP1      ; 0xD9, 0xFE: ????????? R1, ???? ?? 0 - ?????? ?? 2 ????? ?????
    DJNZ R0, LOOP1      ; 0xD8, 0xFC: ????????? R0, ???? ?? 0 - ?????? ?? 4 ????? ?????

    ; --- ?????????? (P3.7 = 0) ---
    MOV P3, #000H       ; 0x75, 0xB0, 0x00: ?????? 0000 0000b ? ???? P3

DELAY_OFF:
    MOV R0, #0FFH       ; 0x78, 0xFF
    MOV R1, #0FFH       ; 0x79, 0xFF
LOOP2:
    DJNZ R1, LOOP2      ; 0xD9, 0xFE
    DJNZ R0, LOOP2      ; 0xD8, 0xFC

    ; --- ???? ---
    SJMP START          ; 0x80, 0xDC: ?????? ????? ?? ????? START (-24 ?????)

END
